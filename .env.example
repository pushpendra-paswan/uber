# Copy to .env for local use. Inside Docker Compose the hosts are `db` and `redis`.

POSTGRES_USER=uber
POSTGRES_PASSWORD=uber_dev_password
POSTGRES_DB=uber
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Place search (M2.1). The public Nominatim server requires an identifying User-Agent:
# replace the contact email with your own.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=uber-clone-learning/1.0 (replace with your contact email)

# Routing (M2.2). The backend calls OSRM at this address inside Docker Compose.
OSRM_URL=http://osrm:5000
# Used only by osrm/prepare.sh, not by the backend. It must be a regional extract that contains
# the whole city, and the CITY_* values below must match the city whose extract is prepared.
OSM_EXTRACT_URL=https://download.geofabrik.de/asia/india/southern-zone-latest.osm.pbf

# The city values are placeholders: change them to your own city.
# Keep them matching the OSRM map extract that osrm/prepare.sh builds.
CITY_NAME=Bengaluru
CITY_CENTER_LAT=12.9716
CITY_CENTER_LNG=77.5946
MAP_ZOOM=12
CITY_SOUTH=12.83
CITY_WEST=77.45
CITY_NORTH=13.14
CITY_EAST=77.75
