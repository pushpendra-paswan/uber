# Copy to .env for local use. Inside Docker Compose the hosts are `db` and `redis`.

POSTGRES_USER=uber
POSTGRES_PASSWORD=uber_dev_password
POSTGRES_DB=uber
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
