    {
      "id": 9,
      "type": "timeseries",
      "title": "WebSocket connections and closes by code",
      "description": "Accepted sockets not yet closed, and sockets closed in the last minute by close code. Counters and the gauge are summed across processes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
